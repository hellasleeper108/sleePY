# PyQuest Environment Configuration
# Copy this file to .env and update with your actual values

# ==============================
# Database Configuration
# ==============================
POSTGRES_USER=pyquest
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=pyquest
POSTGRES_PORT=5432

# Database URL
# For local SQLite (development):
# DATABASE_URL=sqlite:///./pyquest.db
# For PostgreSQL (production/docker):
DATABASE_URL=postgresql://pyquest:your_secure_password_here@db:5432/pyquest

# ==============================
# Backend Configuration
# ==============================
BACKEND_PORT=8000

# Security
# IMPORTANT: Generate a secure secret key for production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://your-domain.com"]

# App Info
APP_NAME=PyQuest
APP_VERSION=1.0.0
DEBUG=True

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Gamification Settings
XP_PER_CHALLENGE_BASE=10
XP_MULTIPLIER_INTERMEDIATE=1.5
XP_MULTIPLIER_ADVANCED=2.0
XP_MULTIPLIER_EXPERT=3.0

# ==============================
# Frontend Configuration
# ==============================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================
# AI Provider Configuration (Optional)
# ==============================
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ==============================
# Nginx Configuration (Production)
# ==============================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ==============================
# Production Deployment
# ==============================
# Render.com
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Vercel
VERCEL_URL=https://your-app.vercel.app
