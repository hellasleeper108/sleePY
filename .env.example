# PyQuest Backend Configuration
# Copy this file to .env and update with your values

# Application
APP_NAME=PyQuest
APP_VERSION=1.0.0
DEBUG=True

# Database
# For SQLite (default, local development):
DATABASE_URL=sqlite:///./pyquest.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/pyquest_db

# Security
# IMPORTANT: Generate a secure secret key for production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS - Update with your frontend URLs
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Gamification Settings
XP_PER_CHALLENGE_BASE=10
XP_MULTIPLIER_INTERMEDIATE=1.5
XP_MULTIPLIER_ADVANCED=2.0
XP_MULTIPLIER_EXPERT=3.0
